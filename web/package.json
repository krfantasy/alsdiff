{
  "name": "alsdiff-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:full": "../scripts/sync_browser_dist.sh && vite build",
    "build:full:release": "DUNE_BUILD_DIR=_build-pages-release dune build --profile release lib/browser/alsdiff.js && mkdir -p web/public && cp _build-pages-release/default/lib/browser/alsdiff.js web/public/alsdiff.js && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:update-snapshots": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
