(data_only_dirs fixtures)

;; In-process rejection harness linking the real ppx modules (see
;; lib/ppx/dune for why ppx_impl exists alongside ppx_patch). -linkall keeps
;; the deriver registrations from being dropped in the link.
(executable
 (name ppx_negative)
 (modules ppx_negative)
 (libraries ppxlib ppx_impl)
 (ocamlopt_flags (:standard -linkall))
 (ocamlc_flags (:standard -linkall)))

(rule
 (alias runtest)
 (deps (glob_files fixtures/*.ml))
 (action
  (run %{exe:ppx_negative.exe} fixtures)))
